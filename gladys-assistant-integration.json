        "fr": "Arrêter un robot"
      },
      "description": {
        "en": "Stops the current job; the robot stays where it is.",
        "fr": "Arrête le travail en cours ; le robot reste où il est."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Robot",
            "fr": "Robot"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "sent",
          "type": "boolean",
          "label": {
            "en": "Order taken",
            "fr": "Ordre pris"
          }
        }
      ]
    },
    {
      "key": "return_to_dock",
      "label": {
        "en": "Send a robot back to its dock",
        "fr": "Renvoyer un robot à sa base"
      },
      "description": {
        "en": "The robot goes back to its dock or station.",
        "fr": "Le robot retourne à sa base ou à sa station."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Robot",
            "fr": "Robot"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "sent",
          "type": "boolean",
          "label": {
            "en": "Order taken",
            "fr": "Ordre pris"
          }
        }
      ]
    },
    {
      "key": "locate_robot",
      "label": {
        "en": "Locate a robot",
        "fr": "Localiser un robot"
      },
      "description": {
        "en": "The robot plays its \"I'm here\" sound.",
        "fr": "Le robot joue son son « Je suis ici »."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Robot",
            "fr": "Robot"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "located",
          "type": "boolean",
          "label": {
            "en": "Robot answered",
            "fr": "Le robot a répondu"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "robot",
      "label": {
        "en": "Ecovacs robot",
        "fr": "Robot Ecovacs"
      },
      "description": {
        "en": "State, battery, error and consumables of a robot, with control buttons.",
        "fr": "État, batterie, erreur et consommables d'un robot, avec boutons de commande."
      },
      "icon": "disc",
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Robot",
            "fr": "Robot"
          },
          "required": true
        }
      ],
      "action_timeout_seconds": 30
    }
  ]
}
