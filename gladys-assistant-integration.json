    {
      "key": "poll_frequency",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement"
      },
      "description": {
        "en": "How often each robot is asked for its state through the cloud.",
        "fr": "Fréquence à laquelle l'état de chaque robot est demandé via le cloud."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "15",
          "label": {
            "en": "15 seconds",
            "fr": "15 secondes"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion"
      },
      "timeout_seconds": 45
    },
    {
      "key": "send_verification_code",
      "label": {
        "en": "Send the verification code",
        "fr": "Envoyer le code de vérification"
      },
      "timeout_seconds": 30
    },
    {
      "key": "verify_device",
      "label": {
        "en": "Confirm the device",
        "fr": "Confirmer l'appareil"
      },
      "timeout_seconds": 45,
      "fields": [
        {
          "key": "code",
          "type": "string",
          "label": {
            "en": "Code received by email",
            "fr": "Code reçu par e-mail"
          },
          "required": true
        }
      ]
    },
    {
      "key": "locate",
      "label": {
        "en": "Locate a robot",
        "fr": "Localiser un robot"
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Robot",
            "fr": "Robot"
          },
          "required": true
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "cleaning_started",
      "label": {
        "en": "Cleaning or mowing started",
        "fr": "Nettoyage ou tonte démarré"
      },
      "description": {
        "en": "A robot started working (not when it resumes after a pause).",
        "fr": "Un robot a commencé à travailler (pas quand il reprend après une pause)."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Robot",
            "fr": "Robot"
          }
        }
      ],
      "variables": [
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Robot name",
            "fr": "Nom du robot"
          }
        }
      ]
    },
    {
      "key": "cleaning_finished",
      "label": {
        "en": "Cleaning or mowing finished",
        "fr": "Nettoyage ou tonte terminé"
      },
      "description": {
        "en": "A robot stopped working: job done, stopped, or on its way back to its dock or station.",
        "fr": "Un robot a fini son travail : terminé, arrêté, ou en route vers sa base ou sa station."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Robot",
            "fr": "Robot"
          }
        }
      ],
      "variables": [
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Robot name",
            "fr": "Nom du robot"
          }
        }
      ]
    },
    {
      "key": "robot_docked",
      "label": {
        "en": "Robot back on its dock",
        "fr": "Robot revenu sur sa base"
      },
      "description": {
        "en": "A robot is back on its dock or station and charging.",
        "fr": "Un robot est revenu sur sa base ou sa station et se recharge."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Robot",
            "fr": "Robot"
          }
        }
      ],
      "variables": [
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Robot name",
            "fr": "Nom du robot"
          }
        }
      ]
    },
    {
      "key": "robot_error",
      "label": {
        "en": "Robot error",
        "fr": "Erreur du robot"
      },
      "description": {
        "en": "A robot reported a new error: stuck, brush blocked, dust bin full...",
        "fr": "Un robot a signalé une nouvelle erreur : coincé, brosse bloquée, bac plein..."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Robot",
            "fr": "Robot"
          }
        }
      ],
      "variables": [
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Robot name",
            "fr": "Nom du robot"
          }
        },
        {
          "key": "code",
          "type": "number",
          "label": {
            "en": "Error code",
            "fr": "Code d'erreur"
          }
        },
        {
          "key": "message",
          "type": "string",
          "label": {
            "en": "Error message (English)",
            "fr": "Message d'erreur (anglais)"
          }
        }
      ]
    },
    {
      "key": "consumable_low",
      "label": {
        "en": "Consumable worn out",
        "fr": "Consommable usé"
      },
      "description": {
        "en": "A brush, filter or blade went down to 10 % of its life or less.",
        "fr": "Une brosse, un filtre ou une lame est descendu à 10 % de sa durée de vie ou moins."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Robot",
            "fr": "Robot"
          }
        },
        {
          "key": "consumable",
          "type": "multi_select",
          "label": {
            "en": "Consumable",
            "fr": "Consommable"
          },
          "options": [
            {
              "value": "main-brush",
              "label": {
                "en": "Main brush",
                "fr": "Brosse principale"
              }
            },
            {
              "value": "side-brush",
              "label": {
                "en": "Side brush",
                "fr": "Brosse latérale"
              }
            },
            {
              "value": "filter",
              "label": {
                "en": "Filter",
                "fr": "Filtre"
              }
            },
            {
              "value": "blade",
              "label": {
                "en": "Blades",
                "fr": "Lames"
              }
            },
            {
              "value": "lens-brush",
              "label": {
                "en": "Camera lens brush",
                "fr": "Brosse de caméra"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Robot name",
            "fr": "Nom du robot"
          }
        },
        {
          "key": "consumable_name",
          "type": "string",
          "label": {
            "en": "Consumable (English)",
            "fr": "Consommable (anglais)"
          }
        },
        {
          "key": "percent",
          "type": "number",
          "label": {
            "en": "Life left (%)",
            "fr": "Durée de vie restante (%)"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "start_robot",
      "label": {
        "en": "Start a robot",
        "fr": "Démarrer un robot"
      },
      "description": {
        "en": "Starts cleaning or mowing, or resumes after a pause.",
        "fr": "Lance le nettoyage ou la tonte, ou reprend après une pause."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Robot",
            "fr": "Robot"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "sent",
          "type": "boolean",
          "label": {
            "en": "Order taken",
            "fr": "Ordre pris"
          }
        }
      ]
    },
    {
      "key": "pause_robot",
      "label": {
        "en": "Pause a robot",
        "fr": "Mettre un robot en pause"
      },
      "description": {
        "en": "Pauses the current cleaning or mowing.",
        "fr": "Met en pause le nettoyage ou la tonte en cours."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Robot",
            "fr": "Robot"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "sent",
          "type": "boolean",
          "label": {
            "en": "Order taken",
            "fr": "Ordre pris"
          }
        }
      ]
    },
    {
      "key": "stop_robot",
